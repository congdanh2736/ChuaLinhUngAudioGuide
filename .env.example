# Sao chép file này thành .env rồi chỉnh giá trị. KHÔNG commit file .env lên GitHub!

APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000

# SQL Server - dữ liệu lưu bền vững, có khóa ngoại. Database audio_guide chưa có thì app tự tạo.
# Cần cài "ODBC Driver 18 for SQL Server" (hoặc 17) - ghi đúng tên driver đã cài vào tham số driver=
#  1) SQL Server Express cài trên máy, đăng nhập bằng tài khoản Windows (dễ nhất):
#     DATABASE_URL=mssql+aioodbc://@localhost\SQLEXPRESS/audio_guide?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#  1b) SQL Server LocalDB (cài sẵn khi cài Visual Studio, không cần service; SSMS kết nối "(localdb)\MSSQLLocalDB"):
#     DATABASE_URL=mssql+aioodbc://@(localdb)\MSSQLLocalDB/audio_guide?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
#  2) Tài khoản SQL (sa) - SQL Server Developer/Docker (docker compose up -d sqlserver):
#     DATABASE_URL=mssql+aioodbc://sa:YourStrong!Passw0rd@localhost:1433/audio_guide?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
DATABASE_URL=mssql+aioodbc://@localhost\SQLEXPRESS/audio_guide?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Production bắt buộc đổi: chuỗi ngẫu nhiên >= 32 ký tự (python -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=change-me-in-production
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_PASSWORD=admin123

# Quyền truy cập: false = mở tự do (tiện khi demo giao diện)
ACCESS_REQUIRED=true
ACCESS_PRICE_VND=50000
PAYMENT_WEBHOOK_SECRET=mock-webhook-secret

# Dịch máy - cần Internet:
#   google   = thử Google -> Google API -> MyMemory, tự chuyển dịch vụ khi bị chặn (khuyên dùng)
#   mymemory = chỉ dùng MyMemory     none = tắt dịch máy
TRANSLATOR_PROVIDER=google
# Điền email bất kỳ của bạn để MyMemory cho dịch nhiều hơn (5.000 -> 50.000 ký tự/ngày)
MYMEMORY_EMAIL=
# Nơi lưu file audio: database = ngay trong SQL Server, bảng media_files (khuyên dùng) | local = thư mục MEDIA_DIR
MEDIA_STORAGE=database
MEDIA_DIR=media
# Giọng đọc: edge | none
TTS_PROVIDER=edge

# Chatbot AI tạo sinh (khuyên dùng). Bỏ trống = chatbot chỉ trích đoạn từ tài liệu của chùa.
# Key Google Gemini MIỄN PHÍ: https://aistudio.google.com/apikey  (AIza... hoặc dạng khác đều được)
# Cũng nhận key Groq (gsk_...) hoặc OpenRouter (sk-or-...) - hệ thống tự nhận ra.
# Dán key KHÔNG có dấu nháy, không có khoảng trắng.
LLM_API_KEY=
# auto = đoán theo đầu key (không nhận ra -> gemini) | gemini | groq | openrouter | none
LLM_PROVIDER=openrouter
# Bỏ trống để dùng model mặc định (Gemini: gemini-2.5-flash)
LLM_MODEL=nvidia/nemotron-3.5-super-vl:free
# Thời gian tối đa chờ AI trả lời 1 câu (giây). Mạng yếu / Google hay quá tải thì tăng lên 120
LLM_TIMEOUT_SECONDS=60


# true = khi khởi động lần đầu tự dịch toàn bộ dữ liệu mẫu sang 16 ngôn ngữ
AUTO_LOCALIZE_ON_STARTUP=false
