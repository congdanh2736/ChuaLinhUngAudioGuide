{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=AudioGuideDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Jwt": {
    "Key": "AudioGuide-LinhUng-Secret-Key-Minimum-32-Characters-2026",
    "Issuer": "AudioGuideApi",
    "Audience": "AudioGuideClient",
    "AdminTokenMinutes": 480
  },

  "Access": {
    "Required": true,
    "PriceVnd": 50000,
    "AccessHours": 24,
    "CodeTtlHours": 24
  },

  "Payment": {
    "Provider": "mock",
    "WebhookSecret": "mock-webhook-secret"
  },

  "Localization": {
    "SourceLanguage": "vi",
    "FallbackLanguage": "en",
    "MaxConcurrentJobs": 3
  },

  "Translator": {
    "Provider": "google",
    "MyMemoryEmail": null
  },

  "Tts": {
    "Provider": "edge"
  },

  "Llm": {
    "Provider": "openrouter",
    "ApiKey": "",
    "Model": "",
    "TimeoutSeconds": 60
  },

  "Chat": {
    "DailyLimit": 50,
    "CacheTtlSeconds": 600,
    "HistoryTurns": 4
  },

  "Site": {
    "UtcOffsetHours": 7
  },

  "Seed": {
    "AdminUserName": "admin",
    "AdminPassword": "admin123",
    "SampleData": true
  }
}
